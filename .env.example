# =========================================================================
# APPLICATION ENVIRONMENT VARIABLES
# -------------------------------------------------------------------------
# Instructions:
# 1. Copy this file and rename it to `.env`
# 2. Fill in your private API keys below
# 3. Do not commit your actual `.env` file to version control!
# =========================================================================

# ==========================================
# 🗄️ Database Configuration
# ==========================================
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD_HERE@localhost:5432/mentimotive

# ==========================================
# 🤖 LLM General Settings
# ==========================================
# Provider selection. Options: "openai" or "gemini"
LLM_PROVIDER=openai

# Creativity of the model (0.0 = deterministic, 1.0 = highly creative)
LLM_TEMPERATURE=0.7

# ==========================================
# 🔐 Authentication
# ==========================================
# Secret key for JWT signing. Generate a secure random string using:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days in minutes

# ==========================================
# 🔑 API Keys & Models
# ==========================================
# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here
# Options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo, etc.
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
# Options: gemini-2.5-flash, gemini-1.5-pro, etc.
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# 🗣️ Voice / Text-to-Speech (TTS)
# ==========================================
# Engine selection. Options: 
# "edge" = High quality, cloud-based (Microsoft Edge)
# "tiny" = Offline, local backup (requires TinyTTS)
TTS_ENGINE=edge

# ==========================================
# 🧠 RAG & Session Memory
# ==========================================
# How many previous messages to remember in a conversation history
MAX_MESSAGES=50

# How many relevant document chunks to fetch during retrieval
RAG_TOP_K=3

# Text splitting configuration for uploaded documents (in characters)
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ==========================================
# 📚 Vector Database & Embeddings
# ==========================================
# HuggingFace model reference for embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Path to the local ONNX model used for generating offline embeddings
ONNX_EMBEDDING_MODEL_PATH=/onnx_models/all-minilm-l6-v2

# Where ChromaDB should store the local database files
CHROMA_PERSIST_DIR=./backend/chroma_db

# Name of the ChromaDB collection to query against
COLLECTION_NAME=mental_health_docs